GITHUB_TOKEN=
OPENAI_API_KEY=
# 手动发布默认关闭；与只读 GITHUB_TOKEN 无凭据回退。仅支持可信本地单用户部署。
REPOGUARDIAN_GITHUB_PUBLISH_ENABLED=false
REPOGUARDIAN_GITHUB_PUBLISH_TOKEN=
# 本地操作口令，至少 32 字符；浏览器只输入此口令，不输入 GitHub PAT。
REPOGUARDIAN_PUBLICATION_API_TOKEN=
# GitHub 数字仓库 ID（逗号分隔），以及该 PAT 的 GitHub 用户数字 ID。
REPOGUARDIAN_GITHUB_PUBLISH_ALLOWED_REPOSITORIES=
# 启用时设置为正整数；留空时应删除或注释此行。
# REPOGUARDIAN_GITHUB_PUBLISH_PUBLISHER_ID=123456
# 在 GitHub 核对 Fine-grained PAT 的 Pull requests: write grant 后设为 true。
REPOGUARDIAN_GITHUB_PUBLISH_PULL_REQUESTS_WRITE_CONFIRMED=false
REPOGUARDIAN_GITHUB_PUBLISH_MAX_INLINE=30
REPOGUARDIAN_GITHUB_PUBLISH_BATCH_SIZE=15
OPENAI_BASE_URL=https://api.openai.com/v1
REPOGUARDIAN_MODEL=gpt-4.1-mini
REPOGUARDIAN_PROVIDER=openai
# DeepSeek 官方 OpenAI 兼容接口（下列示例替换上方三项；OPENAI_API_KEY 填 DeepSeek Key）：
# OPENAI_BASE_URL=https://api.deepseek.com
# REPOGUARDIAN_MODEL=deepseek-flash
# REPOGUARDIAN_PROVIDER=deepseek
# 服务商和模型必须支持原生工具调用；接口不支持时明确失败，不退回自研文本协议。
# 模型须支持原生 Tool Calling 与结构化提交。不强制 JSON mode。
REPOGUARDIAN_MODEL_REQUEST_TIMEOUT_SECONDS=60
REPOGUARDIAN_AGENT_MAX_CALLS=48
REPOGUARDIAN_AGENT_MAX_TOOL_CALLS=80
REPOGUARDIAN_AGENT_OUTPUT_TOKENS=4096
REPOGUARDIAN_REVIEW_TIMEOUT_SECONDS=1800
REPOGUARDIAN_REVIEW_CONCURRENCY=4
# 整轮硬调用上限与累计输入预算；缓存命中仍计入输入。请求前预估预留、返回后按 usage 结算。
REPOGUARDIAN_REVIEW_MAX_MODEL_CALLS=64
REPOGUARDIAN_REVIEW_MAX_INPUT_TOKENS=500000
REPOGUARDIAN_PR_DISCUSSIONS_ENABLED=true
REPOGUARDIAN_GIT_BIN=git
# 单次 Git clone/fetch/diff/checkout 的最大执行时间。
REPOGUARDIAN_GIT_TIMEOUT_SECONDS=900

# 只读审查不运行目标仓库代码。Webhooks 仅在 HMAC 与 allowlist 验证后启动。
REPOGUARDIAN_GITHUB_WEBHOOK_SECRET=
REPOGUARDIAN_INCREMENTAL_REVIEW_WEBHOOK_ENABLED=false
REPOGUARDIAN_INCREMENTAL_REVIEW_WEBHOOK_REPOSITORIES=

# LangSmith 默认关闭。显式开启会向 LangSmith 上传模型输入、工具源码结果和输出。
# 仅在同意这些数据发送到追踪服务时开启；项目和端点使用 LangSmith 原生环境变量。
REPOGUARDIAN_LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=repoguardian
# LANGSMITH_ENDPOINT=

# 以下路径默认相对于 backend/ 目录，可覆盖为自定义路径
# REPOGUARDIAN_WORKDIR=backend/.repoguardian/workspaces
# REPOGUARDIAN_DB_PATH=.repoguardian/native-review.db
# REPOGUARDIAN_CHECKPOINT_DB=.repoguardian/review-checkpoints.db
# 任务队列使用数据库 claim/heartbeat/lease；服务启动前执行 `cd backend && uv run alembic upgrade head`。
REPOGUARDIAN_WORKER_POLL_SECONDS=0.25
REPOGUARDIAN_WORKER_LEASE_SECONDS=300
REPOGUARDIAN_WORKER_MAX_ATTEMPTS=3
REPOGUARDIAN_ARTIFACT_INLINE_MAX_BYTES=64000
# REPOGUARDIAN_ARTIFACT_DIR=backend/.repoguardian/artifacts
REPOGUARDIAN_RETENTION_DAYS=30
# 后台维护：过期任务/checkpoint GC、孤儿 workspace 回收和阈值式 VACUUM
REPOGUARDIAN_MAINTENANCE_INTERVAL_SECONDS=3600
REPOGUARDIAN_ORPHAN_WORKSPACE_TTL_SECONDS=604800
# 预览准备仓库独立回收：有效命中续期，数量/总逻辑字节任一超限淘汰最久未使用项。
# 数量或字节上限设为 0 关闭磁盘复用；源码读取仍锁定双侧提交。
REPOGUARDIAN_PREPARED_WORKSPACE_TTL_SECONDS=3600
REPOGUARDIAN_PREPARED_WORKSPACE_MAX_ENTRIES=4
REPOGUARDIAN_PREPARED_WORKSPACE_MAX_BYTES=4294967296
REPOGUARDIAN_CHECKPOINT_VACUUM_MIN_BYTES=67108864
REPOGUARDIAN_CHECKPOINT_VACUUM_MIN_RATIO=0.2

# DeepSeek example:
# OPENAI_BASE_URL=https://api.deepseek.com
# REPOGUARDIAN_MODEL=deepseek-v4-pro
# REPOGUARDIAN_PROVIDER=deepseek
