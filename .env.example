GITHUB_TOKEN=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
REPOGUARDIAN_MODEL=gpt-4.1-mini
REPOGUARDIAN_PROVIDER=openai
REPOGUARDIAN_GIT_BIN=git

# Product defaults: read-only review never runs repository code.
REPOGUARDIAN_DEFAULT_REVIEW_MODE=review
# 可选：none / user_runner / project_ci / gvisor（user_runner 使用外部用户环境）
REPOGUARDIAN_DEFAULT_VALIDATION_BACKEND=none
REPOGUARDIAN_DEFAULT_VALIDATION_PROFILE=unit

# Project CI 使用仓库显式安装的 GitHub Actions workflow；留空即禁用。
# 需要 GitHub App Metadata/Contents/Checks read 与 Actions read/write，不需要 Contents write。
REPOGUARDIAN_PROJECT_CI_WORKFLOW=
REPOGUARDIAN_PROJECT_CI_REF=main
REPOGUARDIAN_PROJECT_CI_WORKFLOW_NAME=RepoGuardian Validation
# profile -> workflow 结果中必须通过的检查名称。
REPOGUARDIAN_PROJECT_CI_PROFILES=unit=unit
REPOGUARDIAN_PROJECT_CI_ALLOW_FORK=false
REPOGUARDIAN_PROJECT_CI_TIMEOUT_SECONDS=3600
REPOGUARDIAN_PROJECT_CI_POLL_INTERVAL_SECONDS=30
REPOGUARDIAN_PROJECT_CI_MAX_PATCH_INPUT_BYTES=48000
# 用于校验 GitHub workflow_run webhook 的 HMAC secret。
REPOGUARDIAN_GITHUB_WEBHOOK_SECRET=

# User Runner 只接受这里预注册的 profile -> 逻辑 command_id 映射，不接受 shell 字符串。
REPOGUARDIAN_RUNNER_PROFILES=unit=project_unit_tests,lint=project_lint
# Runner 注册与 Validation Request 取消/查询的管理令牌；生产环境必须单独配置。
REPOGUARDIAN_RUNNER_REGISTRATION_TOKEN=
REPOGUARDIAN_RUNNER_CLAIM_TIMEOUT_SECONDS=600
REPOGUARDIAN_RUNNER_REQUEST_TIMEOUT_SECONDS=7200
REPOGUARDIAN_RUNNER_MAX_LOG_SUMMARY_CHARS=8000

# Deterministic Review Unit planning and bounded execution.
REPOGUARDIAN_REVIEW_UNIT_CONCURRENCY=4
REPOGUARDIAN_REVIEW_UNIT_TIMEOUT_SECONDS=180
REPOGUARDIAN_REVIEW_UNIT_SMALL_MAX_CHANGED_LINES=30
REPOGUARDIAN_REVIEW_UNIT_LARGE_MIN_CHANGED_LINES=400
REPOGUARDIAN_REVIEW_UNIT_MAX_LINES_PER_READ=240
REPOGUARDIAN_REVIEW_UNIT_MAX_SEARCH_RESULTS=12

# Candidate Issue -> deterministic policy -> independent verifier -> deduplication.
# Verifier failures are never treated as keep. fail mode: needs_human or candidate.
REPOGUARDIAN_ISSUE_VERIFIER_ENABLED=true
REPOGUARDIAN_ISSUE_VERIFIER_FAIL_MODE=needs_human
REPOGUARDIAN_ISSUE_VERIFIER_MAX_CALLS_PER_UNIT=5

# Candidate patch eligibility and deterministic size limits. Apply-check only;
# these settings do not enable project tests or target-code execution.
REPOGUARDIAN_PATCH_CONFIDENCE_THRESHOLD=0.8
REPOGUARDIAN_PATCH_MAX_FILES=3
REPOGUARDIAN_PATCH_MAX_CHANGED_LINES=80

# Evidence line resolution is deterministic and has no model-controlled or runtime setting.
# Legacy model line_number/line_no values are ignored for publication.

# Command execution defaults to a rejecting sandbox placeholder. A real sandbox runtime
# must be configured before production validation can execute untrusted repository code.
# reject is the safe default; gvisor remains a non-executing placeholder.
REPOGUARDIAN_EXECUTOR=reject
REPOGUARDIAN_ALLOW_UNSAFE_LOCAL_EXECUTION=false
REPOGUARDIAN_SANDBOX_NETWORK=false
REPOGUARDIAN_SANDBOX_MEMORY_MB=512
REPOGUARDIAN_SANDBOX_CPUS=1.0
REPOGUARDIAN_SANDBOX_PIDS_LIMIT=64
REPOGUARDIAN_SANDBOX_TIMEOUT_SECONDS=300
REPOGUARDIAN_SANDBOX_MAX_OUTPUT_CHARS=8000

# LangSmith tracing is opt-in. Leave false to prevent all LangSmith requests.
REPOGUARDIAN_LANGSMITH_TRACING=false
# Required only when tracing is enabled. Never commit a real key.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=repoguardian
# Optional custom endpoint, for example a self-hosted LangSmith deployment.
# LANGSMITH_ENDPOINT=
# false keeps trace structure and safe metadata only; no prompts, diffs, context, or model output.
REPOGUARDIAN_LANGSMITH_INCLUDE_CONTENT=false

# 以下路径默认相对于 backend/ 目录，可覆盖为自定义路径
# REPOGUARDIAN_WORKDIR=backend/.repoguardian/workspaces
# REPOGUARDIAN_DB_PATH=backend/.repoguardian/repoguardian.db
# REPOGUARDIAN_CHECKPOINT_DB=backend/.repoguardian/checkpoints.db
# 任务队列使用数据库 claim/heartbeat/lease；服务启动前执行 `cd backend && uv run alembic upgrade head`。
REPOGUARDIAN_WORKER_POLL_SECONDS=0.25
REPOGUARDIAN_WORKER_LEASE_SECONDS=300
REPOGUARDIAN_WORKER_MAX_ATTEMPTS=3
# HumanRequest 回答 API 的 Bearer token；生产环境必须配置且不要提交真实值。
REPOGUARDIAN_HUMAN_ANSWER_TOKEN=
REPOGUARDIAN_HUMAN_TIMEOUT_SECONDS=86400
REPOGUARDIAN_HUMAN_TIMEOUT_POLICY=fail
REPOGUARDIAN_ARTIFACT_INLINE_MAX_BYTES=64000
# REPOGUARDIAN_ARTIFACT_DIR=backend/.repoguardian/artifacts
REPOGUARDIAN_RETENTION_DAYS=30

# Fingerprint / reuse version boundaries. Any change invalidates incompatible cached conclusions.
REPOGUARDIAN_CONFIG_VERSION=6A-v1
REPOGUARDIAN_PROMPT_VERSION=review-v1
REPOGUARDIAN_RULE_VERSION=rules-v1
REPOGUARDIAN_TOOL_SCHEMA_VERSION=tools-v1
REPOGUARDIAN_REVIEW_POLICY_VERSION=review-policy-v1
REPOGUARDIAN_PATCH_POLICY_VERSION=patch-policy-v1
REPOGUARDIAN_ALLOW_CROSS_MODEL_REUSE=false

# DeepSeek example:
# OPENAI_BASE_URL=https://api.deepseek.com
# REPOGUARDIAN_MODEL=deepseek-v4-pro
# REPOGUARDIAN_PROVIDER=deepseek
